# Optional. Without .streamlit/secrets.toml the app starts in LOCAL DEMO mode.
# Copy to secrets.toml locally; paste into Streamlit Cloud Secrets when deploying.
# NEVER commit real private keys. Every value below is a placeholder.
[firebase]
apiKey = "YOUR_FIREBASE_WEB_API_KEY"
projectId = "YOUR_PROJECT_ID"

[firebase_service_account]
type = "service_account"
project_id = "YOUR_PROJECT_ID"
private_key_id = "YOUR_PRIVATE_KEY_ID"
private_key = """-----BEGIN PRIVATE KEY-----
YOUR_PRIVATE_KEY_BODY
-----END PRIVATE KEY-----
"""
client_email = "YOUR_SERVICE_ACCOUNT_EMAIL"
client_id = "YOUR_CLIENT_ID"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "YOUR_CLIENT_X509_CERT_URL"
